# Used by Next.js web app (apps/web)
NEXT_PUBLIC_SANITY_PROJECT_ID=2qx6srf6
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-02-01

# Optional: enable draft preview mode
SANITY_READ_TOKEN=
NEXT_PREVIEW_SECRET=
SANITY_WEBHOOK_SECRET=

# Basic-auth password for /review and /guides (src/middleware.ts). Unset = closed.
REVIEW_PASSWORD=

# Private route pages (/routes/[token]); scripts/s3/README.md, "Private route pages".
# Cookie signing key, 64 hex characters (openssl rand -hex 32). Unset on a deployed site = closed.
ROUTES_SESSION_SECRET=
# The private bucket the deployed site reads route folders from (read-only key).
ROUTES_S3_BUCKET=
ROUTES_S3_REGION=us-east-1
ROUTES_S3_PREFIX=routes/
ROUTES_S3_ACCESS_KEY_ID=
ROUTES_S3_SECRET_ACCESS_KEY=
# Public Mapbox token restricted to the site's URLs, and the map style.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=
