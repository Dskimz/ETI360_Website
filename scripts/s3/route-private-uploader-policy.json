{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WritePrivateRoutePages",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::eti360-site-private/routes/*"
    },
    {
      "Sid": "ListPrivateRoutePages",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::eti360-site-private",
      "Condition": { "StringLike": { "s3:prefix": ["routes/*"] } }
    }
  ]
}
